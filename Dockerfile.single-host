# Minimal public single-host runtime for Kule. The optional Kubernetes,
# Argo CD and OpenHands integration binaries remain outside this image.
FROM python:3.15.2-slim-bookworm@sha256:96599df822d0e1c6bb700014a05c7f3c8cabc6e0f7ff3c4f9f69cee033b4b5d9 AS wheelhouse
WORKDIR /src
COPY pyproject.toml README.md LICENSE ./
COPY src/ ./src/
RUN python -m pip wheel --no-cache-dir --wheel-dir /wheelhouse .

FROM python:3.15.2-slim-bookworm@sha256:96599df822d0e1c6bb700014a05c7f3c8cabc6e0f7ff3c4f9f69cee033b4b5d9 AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    KULE_SINGLE_HOST_IMAGE=1
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssh-client \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --gid 10001 kule \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent kule \
    && install -d -m 0700 -o 10001 -g 10001 /var/lib/kule \
    && install -d -m 0755 -o root -g root /usr/local/share/kule \
    && touch /usr/local/share/kule/SINGLE_HOST_IMAGE \
    && chmod 0444 /usr/local/share/kule/SINGLE_HOST_IMAGE
COPY --from=wheelhouse /wheelhouse /wheelhouse
RUN python -m pip install --no-cache-dir --no-index --find-links=/wheelhouse kule \
    && rm -rf /wheelhouse
COPY examples/config.example.toml /tmp/kule-config-smoke.toml
# Execute installed CLI on both amd64 and arm64 as part of the image build.
RUN python -m pip check \
    && kule --help >/dev/null \
    && KULE_OIDC_CLIENT_SECRET=ci-placeholder \
       KULE_JWT_SIGNING_KEY="$(python -c 'import secrets; print(secrets.token_urlsafe(48))')" \
       kule check-config --config /tmp/kule-config-smoke.toml \
    && rm -f /tmp/kule-config-smoke.toml
WORKDIR /var/lib/kule
USER 10001:10001
EXPOSE 8795
ENTRYPOINT ["kule"]
CMD ["serve", "--config", "/var/lib/kule/config.toml"]
